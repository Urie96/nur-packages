diff --git a/internal/extrabody/extrabody.go b/internal/extrabody/extrabody.go
new file mode 100644
index 0000000..e443df0
--- /dev/null
+++ b/internal/extrabody/extrabody.go
@@ -0,0 +1,155 @@
+// Package extrabody merges operator-supplied JSON into OpenAI-compatible
+// chat-completion request bodies.
+//
+// Some OpenAI-compatible vendors accept request fields that langchaingo has no
+// option for. The motivating case is DeepSeek: its models run in "thinking"
+// mode by default, and turning that off needs
+//
+//	{"thinking": {"type": "disabled"}}
+//
+// in the request body. Reasoning tokens are billed as output and add latency to
+// every page of an OCR run, so an operator who does not want them currently has
+// no way to say so.
+//
+// OPENAI_EXTRA_BODY carries such fields as a JSON object, e.g.
+//
+//	OPENAI_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
+//
+// The fields are merged into every /chat/completions body sent through this
+// codebase's OpenAI-compatible clients (the metadata LLM, the vision LLM and
+// the LLM-based OCR provider all share ocr.OpenAIHTTPClient). Configured
+// values win over what the SDK put there; nested objects are merged one level
+// at a time so a vendor's default sub-fields survive.
+//
+// Scope is the request path, not the host: any endpoint that serves
+// /chat/completions is affected, which is what an operator pointing
+// OPENAI_BASE_URL at a gateway expects. Everything else (embeddings, other
+// paths) passes through untouched, and with the variable unset the transport
+// is a plain passthrough.
+package extrabody
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/sirupsen/logrus"
+)
+
+var warnOnce sync.Once
+
+// extra returns the configured fields, or nil when OPENAI_EXTRA_BODY is unset
+// or does not hold a JSON object. Parsed per request rather than cached at
+// startup so a changed value is picked up without a restart in tests; the cost
+// is one os.Getenv and one small JSON decode per outgoing chat request.
+func extra() map[string]interface{} {
+	raw := strings.TrimSpace(os.Getenv("OPENAI_EXTRA_BODY"))
+	if raw == "" {
+		return nil
+	}
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil || fields == nil {
+		warnOnce.Do(func() {
+			logrus.Warnf("OPENAI_EXTRA_BODY is not a JSON object, ignoring it: %v", err)
+		})
+		return nil
+	}
+	return fields
+}
+
+// NewTransport wraps next so that the fields from OPENAI_EXTRA_BODY are merged
+// into chat-completion request bodies. Pass http.DefaultTransport (or any
+// other RoundTripper) as next.
+func NewTransport(next http.RoundTripper) http.RoundTripper {
+	if next == nil {
+		next = http.DefaultTransport
+	}
+	return &transport{next: next}
+}
+
+type transport struct {
+	next http.RoundTripper
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	fields := extra()
+	if len(fields) == 0 || req.Body == nil || req.URL == nil ||
+		!strings.HasSuffix(req.URL.Path, "/chat/completions") {
+		return t.next.RoundTrip(req)
+	}
+
+	bodyBytes, err := io.ReadAll(req.Body)
+	req.Body.Close()
+	if err != nil {
+		// Body partially consumed and unreadable: hand back the error instead
+		// of sending a truncated request.
+		req.Body = io.NopCloser(bytes.NewReader(nil))
+		return nil, err
+	}
+
+	merged, mergeErr := mergeBody(bodyBytes, fields)
+	if mergeErr != nil {
+		// Not a JSON object we can merge into: send it unchanged rather than
+		// corrupting the request.
+		req.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+		req.ContentLength = int64(len(bodyBytes))
+		return t.next.RoundTrip(req)
+	}
+
+	req.Body = io.NopCloser(bytes.NewReader(merged))
+	req.ContentLength = int64(len(merged))
+	// http.Transport retries a request after a failed connection reuse by
+	// calling GetBody; without updating it that retry would send the body
+	// without the extra fields.
+	if req.GetBody != nil {
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(merged)), nil
+		}
+	}
+	return t.next.RoundTrip(req)
+}
+
+// mergeBody parses body as a JSON object and merges fields into it.
+func mergeBody(body []byte, fields map[string]interface{}) ([]byte, error) {
+	var payload map[string]interface{}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	// json.Number keeps untouched numeric fields (e.g. a large seed) at their
+	// original precision instead of round-tripping through float64.
+	decoder.UseNumber()
+	if err := decoder.Decode(&payload); err != nil {
+		return nil, err
+	}
+	// Decode stops after one value; reject trailing data so a malformed body
+	// hits the caller's unchanged-body fallback instead of losing bytes.
+	if _, err := decoder.Token(); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("unexpected data after top-level JSON value")
+		}
+		return nil, err
+	}
+	if payload == nil {
+		return nil, fmt.Errorf("JSON body is not an object")
+	}
+	mergeInto(payload, fields)
+	return json.Marshal(payload)
+}
+
+// mergeInto copies src into dst. Nested objects present in both are merged
+// recursively; anything else from src replaces dst's value.
+func mergeInto(dst, src map[string]interface{}) {
+	for key, value := range src {
+		srcObject, srcIsObject := value.(map[string]interface{})
+		if dstObject, dstIsObject := dst[key].(map[string]interface{}); srcIsObject && dstIsObject {
+			mergeInto(dstObject, srcObject)
+			continue
+		}
+		dst[key] = value
+	}
+}
diff --git a/internal/extrabody/extrabody_test.go b/internal/extrabody/extrabody_test.go
new file mode 100644
index 0000000..d6a2fca
--- /dev/null
+++ b/internal/extrabody/extrabody_test.go
@@ -0,0 +1,93 @@
+package extrabody
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestExtraBodyMerged(t *testing.T) {
+	t.Setenv("OPENAI_EXTRA_BODY", `{"thinking":{"type":"disabled"}}`)
+
+	var got []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got, _ = io.ReadAll(r.Body)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	client := &http.Client{Transport: NewTransport(http.DefaultTransport)}
+	body := strings.NewReader(`{"model":"deepseek-flash","messages":[{"role":"user","content":"hi"}]}`)
+	resp, err := client.Post(server.URL+"/chat/completions", "application/json", body)
+	if err != nil {
+		t.Fatalf("request failed: %v", err)
+	}
+	resp.Body.Close()
+
+	var payload map[string]interface{}
+	if err := json.Unmarshal(got, &payload); err != nil {
+		t.Fatalf("body is not JSON: %v (%s)", err, got)
+	}
+	thinking, ok := payload["thinking"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("thinking missing from body: %s", got)
+	}
+	if thinking["type"] != "disabled" {
+		t.Errorf("thinking.type = %v, want disabled", thinking["type"])
+	}
+	if payload["model"] != "deepseek-flash" {
+		t.Errorf("existing fields must survive, got model %v", payload["model"])
+	}
+}
+
+func TestExtraBodyUnsetOrNotChatPath(t *testing.T) {
+	cases := []struct {
+		name     string
+		env      string
+		path     string
+		wantBody string
+	}{
+		{"disabled", "", "/chat/completions", `{"model":"m"}`},
+		{"other path", `{"thinking":{"type":"disabled"}}`, "/embeddings", `{"model":"m"}`},
+		{"invalid json", `not-json`, "/chat/completions", `{"model":"m"}`},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("OPENAI_EXTRA_BODY", tc.env)
+
+			var got []byte
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				got, _ = io.ReadAll(r.Body)
+				w.WriteHeader(http.StatusOK)
+			}))
+			defer server.Close()
+
+			client := &http.Client{Transport: NewTransport(http.DefaultTransport)}
+			resp, err := client.Post(server.URL+tc.path, "application/json", strings.NewReader(tc.wantBody))
+			if err != nil {
+				t.Fatalf("request failed: %v", err)
+			}
+			resp.Body.Close()
+
+			if string(bytes.TrimSpace(got)) != tc.wantBody {
+				t.Errorf("body changed: got %s, want %s", got, tc.wantBody)
+			}
+		})
+	}
+}
+
+func TestMergeBodyKeepsNumbers(t *testing.T) {
+	merged, err := mergeBody([]byte(`{"seed":9007199254740993}`), map[string]interface{}{
+		"thinking": map[string]interface{}{"type": "disabled"},
+	})
+	if err != nil {
+		t.Fatalf("merge failed: %v", err)
+	}
+	if !bytes.Contains(merged, []byte("9007199254740993")) {
+		t.Errorf("integer precision lost: %s", merged)
+	}
+}
