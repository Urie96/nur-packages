name: "Build and populate cache"
on:
  push:
    branches:
      - main
      - master
jobs:
  build:
    runs-on: x86_64-linux
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # The evaluation check now runs on pull requests (pr.yml), so a merge
      # only lands here after it has passed. This job only populates the cache.
      - name: Build
        run: nix build --no-link --keep-going .#ci.x86_64-linux.all
